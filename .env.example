APP_ENV=development
APP_VERSION=0.14.0
LOG_LEVEL=INFO
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TEST_GUILD_ID=
DISCORD_API_BASE_URL=https://discord.com/api/v10
DATABASE_URL=postgresql+asyncpg://commerce:commerce@postgres:5432/commerce
REDIS_URL=redis://redis:6379/0
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
PIX_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
COMMERCE_ADMIN_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FEATURE_CASHBACK=true
FEATURE_AFFILIATE=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_ACTIVITY=false
FEATURE_WEB_DASHBOARD=true
MAX_REQUEST_BODY_BYTES=2097152
TRUSTED_HOSTS=localhost,127.0.0.1
ENFORCE_HSTS=false
RATE_LIMIT_DEFAULT_PER_WINDOW=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
OTEL_SERVICE_NAME=discord-commerce-platform
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
